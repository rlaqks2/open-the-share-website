{
  "name": "open-the-share-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://openthe.kr/",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "sync:blog": "python scripts/sync_blog.py",
    "ship": "git pull --rebase --autostash origin master && npm run build && git add -A && git commit -m \"update site\" && git push origin master",
    "deploy": "npm run ship",
    "deploy:manual": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.10"
  }
}
