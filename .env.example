# 로컬 개발용 환경변수 예시입니다. 복사해서 .env.local 로 저장 후 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)
# ⚠️ VITE_ 로 시작하는 값은 빌드 결과(브라우저)에 그대로 노출됩니다. 비밀값을 넣지 마세요.

# 방문자 로그를 받을 Google Apps Script 웹앱 URL (비워두면 외부 IP 조회/전송을 하지 않음)
VITE_GOOGLE_SHEET_WEBHOOK_URL=

# EmailJS (비워두면 src/config/site.ts 의 기본값 사용)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
