{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 1초 완성: npm install & dev 서버 실행",
      "type": "shell",
      "command": "npm install && npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "detail": "npm install 실행 후 바로 로컬 미리보기 서버(dev)를 실행합니다."
    },
    {
      "label": "🚀 Deploy to GitHub Pages",
      "type": "npm",
      "script": "deploy",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "detail": "Runs npm run build and publishes dist/ to gh-pages branch"
    },
    {
      "label": "⚡ Start Dev Server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "detail": "Starts Vite development server for local testing"
    },
    {
      "label": "📦 Build Only",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "detail": "Compiles TypeScript and bundles via Vite"
    }
  ]
}
